<?xml version="1.0" encoding="UTF-8"?><mxfile host="Electron" agent="finsage-replica" version="24.0.0"><diagram name="1 Flujo FinSage" id="1_flujo_finsage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1120" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="FinSage: RAG por varias vías para reportes financieros" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F2328;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Réplica del paper de Wang et al. (CIKM 2025) sobre un documento de trabajo: el 10-K 2022 de AMD, tomado de FinanceBench" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#5E6670;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1600" height="26" as="geometry"/></mxCell><mxCell id="c4" value="0. Documento" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#3E5F8A;swimlaneFillColor=#EEF1F6;strokeColor=#3E5F8A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;FinanceBench&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Banco público de preguntas sobre reportes de empresas de EE. UU. Cada pregunta trae su respuesta correcta y la página de evidencia.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="15" y="60" width="200" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;10-K 2022 de AMD&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Reporte anual en PDF con texto, tablas y notas financieras.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;121 páginas&lt;br&gt;7 preguntas de prueba&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="15" y="205" width="200" height="160" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Por qué este documento&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Sus preguntas mezclan buscar un dato, calcular y razonar, y la evidencia está repartida por todo el reporte.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CDD3;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;dashed=1;" vertex="1" parent="c4"><mxGeometry x="15" y="390" width="200" height="150" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="1. FFP: preparación del documento (una sola vez)" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#0B6E69;swimlaneFillColor=#E6F4F3;strokeColor=#0B6E69;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="360" height="960" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;1.1 Lectura por página&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El PDF se convierte en texto página por página. Las tablas se conservan como tablas.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;121 páginas, 61 tablas&lt;/b&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Réplica: pymupdf4llm. Paper: MinerU&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c9"><mxGeometry x="15" y="60" width="330" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;1.2 Fragmentación&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El texto se corta en pedazos de hasta 256 tokens. Ningún pedazo cruza de página. Cada título abre una sección nueva. Las tablas largas se parten por filas y cada parte repite el encabezado de columnas.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;670 fragmentos&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c9"><mxGeometry x="15" y="190" width="330" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;1.3 Vectores de significado&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Cada fragmento se convierte en un vector con BGE-M3, para buscar por significado y no solo por palabras.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c9"><mxGeometry x="15" y="360" width="330" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1.4 Quitar duplicados&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Si dos fragmentos son casi iguales (similitud de 0.98 o más) se queda el primero. El que queda recuerda en qué otras páginas estaba su copia.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;598 fragmentos&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c9"><mxGeometry x="15" y="480" width="330" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;1.5 Resumen de cada sección&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Un modelo de lenguaje resume cada sección en dos oraciones y ese resumen se pega a todos sus fragmentos como contexto.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;261 secciones&lt;/b&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Modelo: gpt-6-luna&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c9"><mxGeometry x="15" y="630" width="330" height="130" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;1.6 Tres índices&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;&lt;b&gt;Palabras&lt;/b&gt;: BM25&lt;br&gt;&lt;b&gt;Significado&lt;/b&gt;: FAISS con los vectores&lt;br&gt;&lt;b&gt;Resúmenes&lt;/b&gt;: vectores de los resúmenes de sección&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c9"><mxGeometry x="15" y="780" width="330" height="160" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="2. MPR: búsqueda por cuatro vías (en cada pregunta)" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#2D5DA8;swimlaneFillColor=#EAF0FB;strokeColor=#2D5DA8;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="690" y="120" width="420" height="960" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;2.1 Pregunta en el chat&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;La pregunta llega junto con el historial de la conversación.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="15" y="60" width="390" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;2.2 Reescritura&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Un modelo de lenguaje divide la pregunta en subpreguntas completas, reemplaza pronombres y agrega el contexto del historial.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="15" y="160" width="390" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;BM25&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Busca las palabras exactas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="15" y="285" width="88" height="150" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Densa&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Busca por significado con los vectores&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="115" y="285" width="88" height="150" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Metadatos&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Busca en los resúmenes de sección&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="215" y="285" width="88" height="150" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;HyDE&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Inventa una respuesta posible y busca textos parecidos a ella&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="315" y="285" width="88" height="150" as="geometry"/></mxCell><mxCell id="c29" value="Las cuatro vías corren en paralelo y cada una encuentra evidencia distinta" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#5E6670;fontFamily=Helvetica;" vertex="1" parent="c22"><mxGeometry x="15" y="440" width="390" height="30" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;2.3 Unión y expansión&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Se juntan los hallazgos de las cuatro vías y cada fragmento suma a sus vecinos de página si son parecidos.&lt;/span&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Umbral 0.85 y hasta 5 vecinos, como en el paper&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c22"><mxGeometry x="15" y="480" width="390" height="110" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c25" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="índices" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#0B6E69;fontSize=10;fontColor=#5E6670;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Paper frente a réplica&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;HyDE en el paper usa Qwen 7B ajustado con datos propios. En la réplica HyDE usa gpt-6-luna sin ajuste, porque los datos de ajuste no se publicaron.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CDD3;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;dashed=1;" vertex="1" parent="c22"><mxGeometry x="15" y="620" width="390" height="140" as="geometry"/></mxCell><mxCell id="c42" value="3. DRR: reordenamiento" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#6A4BA8;swimlaneFillColor=#F1ECFA;strokeColor=#6A4BA8;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="260" height="560" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;3.1 Reranker&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Un segundo modelo lee cada candidato junto a la pregunta y los ordena por relevancia real, no solo por parecido.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;Top 5 por subpregunta&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c42"><mxGeometry x="15" y="60" width="230" height="170" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Paper frente a réplica&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El paper entrena su reranker con DPO. La réplica usa bge-reranker-v2-m3 ya entrenado, porque el modelo del paper no se publicó.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CDD3;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;dashed=1;" vertex="1" parent="c42"><mxGeometry x="15" y="255" width="230" height="140" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="4. Respuesta" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#B5602C;swimlaneFillColor=#FBEFE6;strokeColor=#B5602C;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1430" y="120" width="260" height="560" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;4.1 Generación con cita&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El modelo responde usando solo los 5 fragmentos elegidos y cita la página de cada dato.&lt;/span&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Modelo: gpt-6-luna&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c46"><mxGeometry x="15" y="60" width="230" height="150" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;4.2 Fusión&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Si hubo varias subpreguntas, sus respuestas se unen en una sola.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c46"><mxGeometry x="15" y="235" width="230" height="110" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="5. Chatbot visual" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#3C3B37;swimlaneFillColor=#F3F3F1;strokeColor=#3C3B37;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1720" y="120" width="270" height="560" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Respuesta en vivo&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El texto aparece mientras se genera, con cada cita como un botón.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c51"><mxGeometry x="15" y="60" width="240" height="115" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Panel: cómo lo encontré&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Muestra en vivo las subpreguntas, lo que trajo cada vía y el top del reranker.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c51"><mxGeometry x="15" y="195" width="240" height="115" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Visor del PDF&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Al tocar una cita se abre el reporte en la página citada.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c51"><mxGeometry x="15" y="330" width="240" height="100" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Corridas grabadas&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Respaldo para la exposición con corridas reales guardadas.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c51"><mxGeometry x="15" y="450" width="240" height="90" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="6. Evaluación (espejo de las tablas del paper)" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#9A6412;swimlaneFillColor=#FFF7E6;strokeColor=#9A6412;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1140" y="710" width="850" height="370" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;A. Aporte de cada vía&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Se agrega una vía por vez: densa, luego BM25, metadatos, HyDE y expansión.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;Mide si la página de evidencia aparece entre lo encontrado&lt;/b&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Tabla 1 del paper&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c57"><mxGeometry x="15" y="60" width="260" height="200" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;B. FinSage frente a RAG simple&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Mismo modelo en los dos. Un juez de otra familia (Qwen local) decide si cada respuesta es correcta.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#0B6E69'&gt;Exactitud y acierto de la página citada&lt;/b&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Tabla 2 del paper&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c57"><mxGeometry x="295" y="60" width="260" height="200" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;C. Tiempo y costo&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Segundos, tokens y dólares de cada etapa por pregunta.&lt;/span&gt;&lt;br&gt;&lt;i style='color:#5E6670;font-size:10px'&gt;Tabla 3 del paper&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c57"><mxGeometry x="575" y="60" width="260" height="200" as="geometry"/></mxCell><mxCell id="c61" value="Con 7 preguntas los resultados se leen pregunta por pregunta y se comparan con el paper de forma cualitativa." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5E6670;fontFamily=Helvetica;" vertex="1" parent="c57"><mxGeometry x="15" y="275" width="820" height="60" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="Estado" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F2328;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="230" height="24" as="geometry"/></mxCell><mxCell id="c64" value="Hecho y probado" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="230" height="30" as="geometry"/></mxCell><mxCell id="c65" value="Programado, listo para correr" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#9A6412;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="30" as="geometry"/></mxCell><mxCell id="c66" value="Pendiente" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="230" height="30" as="geometry"/></mxCell><mxCell id="c67" value="Nota: paper frente a réplica" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CDD3;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="230" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Recorrido de una pregunta" id="2_recorrido_de_una_pregunta"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Recorrido de una pregunta real por el sistema" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F2328;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Pregunta de FinanceBench sobre el 10-K 2022 de AMD: ¿AMD reportó concentración de clientes en el año fiscal 2022?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#5E6670;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1700" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Antes de cualquier pregunta: el documento se prepara una vez" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#0B6E69;swimlaneFillColor=#E6F4F3;strokeColor=#0B6E69;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1880" height="250" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Página 12 del PDF&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Sección de clientes del reporte, con texto corrido y el dato buscado.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="15" y="60" width="270" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Fragmento AMD_2022_10K:11:0&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Sección: Customers&lt;br&gt;105 tokens, solo de la página 12&lt;br&gt;&lt;br&gt;&lt;span style='color:#1F2328'&gt;“One customer accounted for 16% of our consolidated net revenue for the year ended December 31, 2022.”&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="310" y="60" width="340" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Vector BGE-M3&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El fragmento se convierte en un vector de 1024 números que representa su significado.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="675" y="60" width="260" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Sin duplicado&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;No tiene copias casi iguales en el reporte, así que se conserva tal cual. Queda entre los 598 fragmentos finales.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="960" y="60" width="280" height="170" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Resumen de la sección&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Un modelo resume la sección Customers y ese resumen viaja como contexto pegado al fragmento.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#9A6412;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="1265" y="60" width="270" height="170" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Tres índices&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El fragmento queda buscable por sus palabras, por su significado y por el resumen de su sección.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c4"><mxGeometry x="1560" y="60" width="300" height="170" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Cuando llega la pregunta: RAG por cuatro vías" style="swimlane;html=1;startSize=44;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#2D5DA8;swimlaneFillColor=#EAF0FB;strokeColor=#2D5DA8;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1880" height="290" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Pregunta&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;&lt;span style='color:#1F2328'&gt;“Did AMD report customer concentration in FY22?”&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c16"><mxGeometry x="15" y="60" width="250" height="210" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Reescritura&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Queda como una subpregunta completa, con empresa y año explícitos, lista para buscar.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c16"><mxGeometry x="290" y="60" width="260" height="210" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Cuatro vías&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;&lt;b&gt;BM25&lt;/b&gt; encuentra las palabras customer y revenue&lt;br&gt;&lt;b&gt;Densa&lt;/b&gt; encuentra el significado&lt;br&gt;&lt;b&gt;Metadatos&lt;/b&gt; encuentra la sección Customers&lt;br&gt;&lt;b&gt;HyDE&lt;/b&gt; imagina una respuesta y busca textos parecidos&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c16"><mxGeometry x="575" y="60" width="310" height="210" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Reranker&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;Ordena los candidatos y el fragmento de la página 12 debería quedar primero entre los 5 elegidos.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c16"><mxGeometry x="910" y="60" width="260" height="210" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Respuesta con cita&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;El modelo responde solo con esos 5 fragmentos y cita la página.&lt;br&gt;&lt;br&gt;&lt;b&gt;Respuesta esperada según FinanceBench&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1F2328'&gt;Sí, un cliente representó el 16% de los ingresos netos consolidados.&lt;/span&gt;&lt;br&gt;Evidencia: página 12&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c16"><mxGeometry x="1195" y="60" width="320" height="210" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Chatbot&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5E6670'&gt;La respuesta aparece en vivo. La cita es un botón que abre el PDF en la página 12, junto al extracto citado.&lt;br&gt;&lt;br&gt;Así se puede comprobar con los propios ojos que el dato está en el documento.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;strokeWidth=1.4;fontColor=#1F2328;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="c16"><mxGeometry x="1540" y="60" width="320" height="210" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5E6670;fontSize=10;fontColor=#5E6670;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="los índices alimentan la búsqueda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#0B6E69;fontSize=10;fontColor=#5E6670;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Estado" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F2328;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="230" height="24" as="geometry"/></mxCell><mxCell id="c30" value="Hecho y probado" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#2F7D3B;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="763" width="200" height="28" as="geometry"/></mxCell><mxCell id="c31" value="Programado, listo para correr" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#9A6412;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="763" width="220" height="28" as="geometry"/></mxCell><mxCell id="c32" value="Pendiente" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#8E8B85;fontSize=10;fontColor=#1F2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="763" width="140" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>